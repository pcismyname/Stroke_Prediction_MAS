# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.conda/
conda-env/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
.jupyter/

# ---- Data (keep raw data out of git; add exceptions below if needed) ----
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
!data/README.md
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.zip
*.gz
*.tar
*.7z
# Keep small sample files, e.g.:
# !data/sample/*.csv
# The primary dataset is small (317 KB) and committed so a clone runs end to end.
!data/raw/healthcare-dataset-stroke-data.csv
# Result tables back the report, so they are committed too.
!results/tables/*.csv

# ---- Models & experiment outputs ----
models/
*.joblib
*.sav
*.pt
*.pth
*.ckpt
*.onnx
*.keras
mlruns/
wandb/
lightning_logs/
outputs/
logs/
# results/ is committed on purpose: figures and tables back the report.
# Large intermediate files belong in data/interim instead.
catboost_info/

# ---- Environment & secrets ----
.env
.env.*
*.key
secrets.*

# ---- Testing / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
